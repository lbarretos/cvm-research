# Banco local SQLite (obrigatório)
DATABASE_URL=sqlite:///cvm_research.db

# Notificações via Telegram (opcional)
# Obtenha com @BotFather e envie /start para seu bot ou @userinfobot para ver seu chat id
# Podem ser configuradas aqui ou globalmente em ~/.telegram_notifier.env
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
